# Metadata (used in blog pages)
SITE_NAME=
AUTHOR_NAME=

# Postgres connection string. Neon: use the pooled connection string.
DATABASE_URL=

# Better Auth. Required in production; the server refuses to start without it.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of the site, for example http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000

# Used only by `bun run db:seed` to create the first admin. Not read by the app.
# The password needs at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
